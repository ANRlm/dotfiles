# ── Shell ─────────────────────────────────────────────────────────────

shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo

# ── macOS ─────────────────────────────────────────────────────────────

macos-titlebar-style = transparent
macos-option-as-alt  = true
macos-titlebar-proxy-icon = hidden
# Quitting the app makes macOS SIGTERM every process in Ghostty's coalition,
# including the setsid'd herdr server (herdr#4920); closing windows does not.
keybind = super+q=close_all_windows

# ── Font ──────────────────────────────────────────────────────────────

font-family = MesloLGS Nerd Font Mono
font-family = PingFang SC
font-thicken = true
font-thicken-strength = 128
font-size = 14

# ── Theme & Colors ────────────────────────────────────────────────────

theme = Rose Pine
background-opacity      = 1
background-blur         = 85
window-colorspace       = display-p3

# ── Window & Splits ───────────────────────────────────────────────────

unfocused-split-opacity = 0.8
window-padding-x        = 12
window-padding-y        = 8
window-padding-balance  = true
window-width            = 140
window-height           = 45

# ── Mouse & Clipboard ─────────────────────────────────────────────────

mouse-hide-while-typing = true
clipboard-read = allow
