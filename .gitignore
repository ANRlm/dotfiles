# ── Local Files ───────────────────────────────────────────────────────

.DS_Store
.claude/worktrees/

# ── Plugins (installed by their managers) ─────────────────────────────

tmux/plugins/
yazi/plugins/
yazi/flavors/
fish/completions/
herdr/plugins/github-installations/
herdr/plugins/.locks/
herdr/plugins.json
herdr/.plugins.lock
