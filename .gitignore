.DS_Store
.claude/worktrees/

# ── Plugins (installed by their managers) ─────────────────────────────

tmux/plugins/
yazi/plugins/
yazi/flavors/
fish/completions/
herdr/plugins/github/
herdr/plugins.json
herdr/.plugins.lock

# ── Runtime State ─────────────────────────────────────────────────────

fish/fish_variables
herdr/*.log
herdr/*.sock
herdr/*.sock.agent
herdr/session.json
herdr/session-snapshots/
herdr/release-notes.json

# ── Pi & cmux (only reviewed config files) ─────────────────────────────

/pi/*
!/pi/keybindings.json
!/pi/extensions/
/pi/extensions/*
!/pi/extensions/minimal-statusline.ts
!/pi/tests/
/pi/tests/*
!/pi/tests/statusline.test.mjs
/cmux/*
!/cmux/cmux.json
!/cmux/config.ghostty
