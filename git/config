# ── Identity ──────────────────────────────────────────────────────────

[user]
    name = cnhyk
    email = nai.ying.cnhyk@gmail.com

# ── Core ──────────────────────────────────────────────────────────────

[core]
    excludesfile = ~/.config/git/ignore
    editor = hx
    pager = delta

# ── Diff & Pager ──────────────────────────────────────────────────────

[interactive]
    diffFilter = delta --color-only

[delta]
    line-numbers = true
    navigate = true
    hyperlinks = true

[diff]
    algorithm = histogram
    colorMoved = default
    colorMovedWS = allow-indentation-change

# ── Repository & Sync ─────────────────────────────────────────────────

[init]
    defaultBranch = main

[fetch]
    prune = true

[pull]
    rebase = true

[rebase]
    autoStash = true

[push]
    autoSetupRemote = true

# ── Merge & Conflict Resolution ───────────────────────────────────────

[merge]
    conflictStyle = zdiff3

[rerere]
    enabled = true
