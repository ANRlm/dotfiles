    name = cnhyk
    email = nai.ying.cnhyk@gmail.com

[core]
    excludesfile = ~/.config/git/ignore
    editor = nvim

[init]
    defaultBranch = main

[fetch]
    prune = true

[pull]
    rebase = true

[rebase]
    autoStash = true

[push]
    autoSetupRemote = true

[merge]
    conflictStyle = zdiff3

[diff]
    colorMoved = default
