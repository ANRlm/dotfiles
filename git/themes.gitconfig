[delta "everforest-dark"]
    # Inspired by the Everforest Dark palette
    dark = true
    syntax-theme = gruvbox-dark
    line-numbers = true
    side-by-side = true
    commit-style = "#859289"
    commit-decoration-style = none
    file-style = "#d3c6aa" bold
    file-decoration-style = "#475258" ul
    file-added-label = [+]
    file-copied-label = [==]
    file-modified-label = [*]
    file-removed-label = [-]
    file-renamed-label = [->]
    hunk-header-style = file line-number syntax
    hunk-header-decoration-style = "#475258" box ul
    hunk-header-file-style = "#83c092" bold
    hunk-header-line-number-style = "#7fbbb3"
    line-numbers-left-format = "{nm:>3} "
    line-numbers-right-format = "{np:>3} "
    plus-style = syntax "#2f383e"
    plus-emph-style = syntax "#374145"
    plus-empty-line-marker-style = "#374145"
    minus-style = syntax "#4c3743"
    minus-emph-style = syntax "#5b4048"
    minus-empty-line-marker-style = "#5b4048"
    line-numbers-minus-style = "#e67e80"
    line-numbers-plus-style = "#a7c080"
    line-numbers-left-style = "#475258"
    line-numbers-right-style = "#475258"
    line-numbers-zero-style = "#859289"
    zero-style = syntax
    whitespace-error-style = "#e67e80" reverse
    blame-code-style = syntax
    blame-palette = "#232a2e" "#2d353b" "#343f44" "#475258"
    merge-conflict-begin-symbol = ~
    merge-conflict-end-symbol = ~
    merge-conflict-ours-diff-header-style = "#dbbc7f" bold
    merge-conflict-ours-diff-header-decoration-style = "#475258" box
    merge-conflict-theirs-diff-header-style = "#dbbc7f" bold
    merge-conflict-theirs-diff-header-decoration-style = "#475258" box
